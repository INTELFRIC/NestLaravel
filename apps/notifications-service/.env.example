APP_NAME=NotificationsService
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# -----------------------------------------------------------------------------
# SERVICE-TO-SERVICE trust (NestLaravel)
# Must equal the gateway's NOTIFICATIONS_SERVICE_SECRET. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Never expose this service port publicly; the gateway is the only caller.
# -----------------------------------------------------------------------------
INTERNAL_SERVICE_SECRET=
INTERNAL_SIGNATURE_TTL=60
# -----------------------------------------------------------------------------
# Kafka (nestlaravel/kafka) — see docs/KAFKA.md
# Production: KAFKA_SECURITY_PROTOCOL=sasl_ssl + credentials from your secret store.
# -----------------------------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_USE_OUTBOX=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=notifications-service
KAFKA_GROUP_ID=notifications-service
KAFKA_TOPIC_DEFAULT=notifications.events
KAFKA_SECURITY_PROTOCOL=plaintext
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=

# -----------------------------------------------------------------------------
# Reliability (nestlaravel/kafka >= 1.1) — see RELIABILITY.md
# -----------------------------------------------------------------------------
# Transactional inbox: a redelivered event can never repeat a business effect (needs `php artisan migrate`).
KAFKA_INBOX_ENABLED=true
KAFKA_INBOX_RETENTION_DAYS=14
# Refuse to publish events that have no registered schema (generated events always have one).
KAFKA_SCHEMA_ENFORCE_PRODUCER=true
KAFKA_SCHEMA_ENFORCE_CONSUMER=false
KAFKA_OUTBOX_VISIBILITY_TIMEOUT=300
# Secret rotation without downtime: put the OLD secret here while the gateway rolls to the new one.
INTERNAL_SERVICE_SECRET_PREVIOUS=
# Nonce store for replay protection must be shared by all replicas (redis). Refuse requests if it is down.
INTERNAL_NONCE_STORE=
INTERNAL_REPLAY_PROTECTION_REQUIRED=true
# Readiness fails only for these dependencies (database,redis,cache,kafka). Liveness never depends on any.
HEALTH_REQUIRED=database
# GET /metrics needs `Authorization: Bearer <token>`; empty = endpoint disabled.
METRICS_TOKEN=
# Optional OpenTelemetry (OTLP/HTTP) span export.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# JSON logs to stderr with request/correlation/trace/tenant ids: LOG_CHANNEL=nestlaravel
