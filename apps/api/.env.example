# =============================================================================
# NestLaravel API gateway — PUBLIC interface (apps/api)
# Copy to .env. NEVER commit .env. `npx nestlaravel create` fills the secrets.
# =============================================================================

APP_NAME=gateway
APP_ENV=local
# Generated by `php artisan key:generate`
APP_KEY=
# NEVER true in production (leaks stack traces, env and config).
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# sqlite for zero-setup local dev; pgsql in production (own database + user per app).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=app
# DB_USERNAME=app
# DB_PASSWORD=

# --- Session / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis (required for QUEUE/CACHE/SESSION=redis) ------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Redis MUST have a password outside your laptop.
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible; only if FILESYSTEM_DISK=s3) --------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- CORS: origins of YOUR portals only (never "*") -------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Kafka (see docs/KAFKA.md) ----------------------------------------------
KAFKA_ENABLED=false
KAFKA_USE_OUTBOX=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=gateway
KAFKA_GROUP_ID=gateway
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_PRODUCER=auto
KAFKA_CONSUMER=auto
# Production: sasl_ssl (or ssl) + credentials from your secret store.
KAFKA_SECURITY_PROTOCOL=plaintext
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=
KAFKA_TOPIC_DEFAULT=domain.events
KAFKA_TOPIC_VEHICLE=vehicle.events
KAFKA_TOPIC_ORDER=order.events
KAFKA_TOPIC_PAYMENT=payment.events
KAFKA_TOPIC_NOTIFICATION=notification.events
KAFKA_TOPIC_FRAUD=fraud.events
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_MAX_ATTEMPTS=5
KAFKA_OUTBOX_RETRY_DELAY=30
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_BACKOFF_MS=200
KAFKA_IDEMPOTENCY_TTL=86400
KAFKA_EVENT_MAX_VERSION=1
REDIS_IDEMPOTENCY_PREFIX=idempotency:
REDIS_LOCK_PREFIX=lock:
INFRA_CACHE_STORE=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5

# --- MCP endpoint -------------------------------------------------------------
MCP_WEB_AUTH=true

# =============================================================================
# API Gateway: PUBLIC → INTERNAL. Enable a service only after it is deployed.
# Each service has its OWN signing secret (generate: php -r "echo bin2hex(random_bytes(32));")
# and the service must be configured with the same value as INTERNAL_SERVICE_SECRET.
# =============================================================================
GATEWAY_ENABLED=true
GATEWAY_DEFAULT_TIMEOUT=10

GATEWAY_ORDERS_ENABLED=false
ORDERS_SERVICE_URL=http://127.0.0.1:8001
ORDERS_SERVICE_SECRET=
# Docker: ORDERS_SERVICE_URL=http://orders-service:80

GATEWAY_PAYMENTS_ENABLED=false
PAYMENTS_SERVICE_URL=http://127.0.0.1:8002
PAYMENTS_SERVICE_SECRET=

GATEWAY_NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:8003
NOTIFICATIONS_SERVICE_SECRET=
