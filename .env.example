# NestLaravel — compose/infra variables. Copy to .env; NEVER commit .env.
# `npx nestlaravel create` generates this file with fresh random secrets.
# Per-app settings live in apps/<name>/.env (see each .env.example).

COMPOSE_PROJECT_NAME=nestlaravel

# --- Database (Postgres) ---
DB_DATABASE=app
DB_USERNAME=app
# Required. Generate: openssl rand -hex 24
DB_PASSWORD=

# --- Redis ---
# Required. Generate: openssl rand -hex 24
REDIS_PASSWORD=

# --- Host port bindings (always bound to 127.0.0.1) ---
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT_HOST=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# --- Optional "tools" profile: docker compose --profile tools up ---
# Required only with that profile.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
