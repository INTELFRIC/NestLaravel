{
    "name": "nestlaravel/kafka",
    "description": "NestLaravel Kafka kit: event envelope, outbox, hardened producer/consumer, retry + DLQ, idempotency.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0"
    },
    "suggest": {
        "ext-rdkafka": "Required in production for real Kafka connectivity (falls back to log/null drivers without it)."
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "NestLaravel\\Kafka\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NestLaravel\\Kafka\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NestLaravel\\Kafka\\KafkaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
