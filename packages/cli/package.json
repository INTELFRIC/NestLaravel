  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:templates": "node scripts/build-templates.mjs",
    "prepack": "node scripts/build-templates.mjs",
    "test": "node --test \"test/*.test.js\"",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
