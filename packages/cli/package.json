{
  "name": "nestlaravel",
  "version": "1.0.0",
  "description": "NestLaravel — the Nx + Laravel microservice framework with Kafka. Create, generate, develop, build and upgrade projects.",
  "keywords": [
    "nestlaravel",
    "nx",
    "laravel",
    "microservices",
    "kafka",
    "monorepo",
    "cli",
    "scaffold"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
